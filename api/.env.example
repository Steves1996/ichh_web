# Connexion PostgreSQL (vous fournissez la base — créez-la dans pgAdmin, ex. « ichh »)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ichh

# Port d'écoute de l'API
PORT=3001

# URL publique de l'API (sert à construire l'URL des images uploadées)
PUBLIC_URL=http://localhost:3001

# Origines autorisées (CORS) — le site vitrine et le back-office, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174

# Secret de signature des jetons JWT (mettez une longue chaîne aléatoire en production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Compte administrateur créé au premier démarrage / au seed
ADMIN_EMAIL=admin@ichh2026.org
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Administrateur ICHH

# En dev, TypeORM crée/synchronise les tables automatiquement. Passez à false en prod (utilisez les migrations).
DB_SYNCHRONIZE=true
